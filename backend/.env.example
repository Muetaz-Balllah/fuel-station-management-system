# Copy to .env on the server. See ../DEPLOYMENT.md for hosting steps.
# Change JWT_SECRET and passwords before any shared deployment.
# SQLite is the default. To use PostgreSQL later, change only this line:
# DATABASE_URL=postgresql+psycopg://fuel:fuel@localhost:5432/fuel_station
DATABASE_URL=sqlite:///./fuel_station.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
SEED_ON_STARTUP=true
AUTO_CREATE_TABLES=true
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=Manager@12345
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=Operator@12345
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_ASSETS=true
CORS_ORIGINS=*
