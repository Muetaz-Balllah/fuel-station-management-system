# Copy to .env for local dev. Production: see .env.production.example and docs/FREE_HOSTING_GUIDE_AR.md
# SQLite is the default locally. Neon/Koyeb: paste postgresql://... from Neon (auto-converted to psycopg).
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./fuel_station.db
# Upstash: use Redis URL (rediss://...), not UPSTASH_REDIS_REST_URL
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
SEED_ON_STARTUP=true
AUTO_CREATE_TABLES=true
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=Manager@12345
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=Operator@12345
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_ASSETS=true
CORS_ORIGINS=*
