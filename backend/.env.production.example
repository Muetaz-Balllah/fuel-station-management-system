# Production template (Render Web Service / Docker). Environment → Add variables.
# Keep a private copy outside Git.

# --- Neon (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Upstash (Redis sessions) ---
# Redis URL (rediss://...), not UPSTASH_REDIS_REST_* alone.
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379

# --- S3-compatible object storage (images: station logo, user photo, supplier logo) ---
# Works with Tigris, Cloudflare R2, MinIO, AWS S3, etc.
# boto3 reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from the environment automatically.
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=auto
S3_BUCKET=your-bucket-name
# Optional object key prefix inside the bucket
S3_PREFIX=images
# Optional: public CDN URL (https://...). If empty, files are served via GET /api/v1/media/{filename}
# S3_PUBLIC_BASE_URL=https://your-public-bucket-host.example.com

JWT_SECRET=generate-at-least-32-random-characters-here
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
SEED_DEMO_ASSETS=true
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=change-me-after-first-login
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=change-me-after-first-login

# Flutter Web on Vercel (your *.vercel.app URL after deploy)
CORS_ORIGINS=https://your-project.vercel.app
