# Production template (Koyeb). Copy values into Koyeb → Service → Environment variables.
# Do not commit real secrets. Keep a private copy in a password manager.

# --- Neon (PostgreSQL) ---
# Dashboard: Connection string → pooled or direct. Paste as-is (postgresql:// is OK).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Upstash (Redis sessions) ---
# Use "Redis URL" (rediss://...), NOT the REST URL (UPSTASH_REDIS_REST_*).
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR-ENDPOINT.upstash.io:6379

JWT_SECRET=generate-at-least-32-random-characters-here
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15

AUTO_CREATE_TABLES=true
# First deploy only: creates demo users/assets. Set false after go-live.
SEED_ON_STARTUP=true
SEED_DEMO_ASSETS=true
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=change-me-after-first-login
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=change-me-after-first-login
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-after-first-login

# After Render deploy: Flutter web URL(s), comma-separated. Mobile apps do not need a web origin here
# unless you also open the API from a browser on another domain.
CORS_ORIGINS=https://fuel-station-web.onrender.com
